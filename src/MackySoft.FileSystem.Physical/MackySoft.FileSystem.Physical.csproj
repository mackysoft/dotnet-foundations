<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../eng/package-families/filesystem.props" />

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>MackySoft.FileSystem.Physical</AssemblyName>
    <RootNamespace>MackySoft.FileSystem</RootNamespace>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>MackySoft.FileSystem.Physical</PackageId>
    <Version>$(FileSystemVersion)</Version>
    <PackageVersion>$(FileSystemVersion)</PackageVersion>
    <Description>Product-independent physical filesystem observation, link-policy path resolution, and complete single-file publication.</Description>
    <PackageTags>filesystem;path;symlink;atomic-file</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../MackySoft.FileSystem/MackySoft.FileSystem.csproj">
      <Version>$(FileSystemVersion)</Version>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="" Link="LICENSE" />
    <None Update="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>

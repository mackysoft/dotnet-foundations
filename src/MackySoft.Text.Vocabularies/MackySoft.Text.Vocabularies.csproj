<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>MackySoft.Text.Vocabularies</AssemblyName>
    <RootNamespace>MackySoft.Text.Vocabularies</RootNamespace>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <IsPackable>true</IsPackable>
    <PackageId>MackySoft.Text.Vocabularies</PackageId>
    <Description>Finite typed vocabularies with canonical text mappings.</Description>
    <PackageTags>text;vocabulary;serialization</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="" Link="LICENSE" />
    <None Update="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>

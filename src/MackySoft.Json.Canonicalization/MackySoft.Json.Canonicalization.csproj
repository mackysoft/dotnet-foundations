<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../eng/package-families/json-canonicalization.props" />

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>MackySoft.Json.Canonicalization</AssemblyName>
    <RootNamespace>MackySoft.Json.Canonicalization</RootNamespace>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>MackySoft.Json.Canonicalization</PackageId>
    <Version>$(JsonCanonicalizationVersion)</Version>
    <PackageVersion>$(JsonCanonicalizationVersion)</PackageVersion>
    <Description>Product-independent RFC 8785 JSON canonicalization for .NET.</Description>
    <PackageTags>json;canonicalization;rfc8785;jcs</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="" Link="LICENSE" />
    <None Update="README.md" Pack="true" PackagePath="" />
    <None Update="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" />
    <None Update="licenses/Apache-2.0.txt" Pack="true" PackagePath="licenses/Apache-2.0.txt" />
    <None Update="licenses/MPL-2.0.txt" Pack="true" PackagePath="licenses/MPL-2.0.txt" />
  </ItemGroup>

</Project>
